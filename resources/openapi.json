  "components": {
    "schemas": {
      "Activity": {
        "type": "object",
        "required": ["client_id", "dirty"],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          }
        }
      },
      "CaptionStyle": {
        "type": "object",
        "required": [
          "enabled",
          "preset",
          "font",
          "size",
          "color",
          "highlight_color",
          "outline_color",
          "outline",
          "position_y",
          "words_per_line",
          "animation"
        ],
        "properties": {
          "animation": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "font": {
            "type": "string"
          },
          "highlight_color": {
            "type": "string"
          },
          "outline": {
            "type": "number",
            "format": "double"
          },
          "outline_color": {
            "type": "string"
          },
          "position_y": {
            "type": "number",
            "format": "double"
          },
          "preset": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "words_per_line": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Clip": {
        "type": "object",
        "required": [
          "id",
          "project_id",
          "name",
          "explanation",
          "revision",
          "document",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "document": {
            "$ref": "#/components/schemas/EditDocument"
          },
          "explanation": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          },
          "score": {
            "type": ["integer", "null"],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "CreateClipRequest": {
        "type": "object",
        "required": ["name", "start_ms", "end_ms"],
        "properties": {
          "end_ms": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CropRect": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "height": {
            "type": "number",
            "format": "double"
          },
          "width": {
            "type": "number",
            "format": "double"
          },
          "x": {
            "type": "number",
            "format": "double"
          },
          "y": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "EditDocument": {
        "type": "object",
        "required": [
          "version",
          "start_ms",
          "end_ms",
          "layout",
          "resolution",
          "crop",
          "keyframes",
          "gameplay_crop",
          "facecam_crop",
          "split_ratio",
          "captions",
          "title",
          "watermark",
          "words"
        ],
        "properties": {
          "captions": {
            "$ref": "#/components/schemas/CaptionStyle"
          },
          "crop": {
            "$ref": "#/components/schemas/CropRect"
          },
          "end_ms": {
            "type": "integer",
            "format": "int64"
          },
          "facecam_crop": {
            "$ref": "#/components/schemas/CropRect"
          },
          "gameplay_crop": {
            "$ref": "#/components/schemas/CropRect"
          },
          "keyframes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Keyframe"
            }
          },
          "layout": {
            "$ref": "#/components/schemas/Layout"
          },
          "resolution": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "split_ratio": {
            "type": "number",
