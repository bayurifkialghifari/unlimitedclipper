  "components": {
    "schemas": {
      "Activity": {
        "type": "object",
        "required": ["client_id", "dirty"],
        "properties": { "client_id": { "type": "string" }, "dirty": { "type": "boolean" } }
      },
      "AudioAsset": {
        "type": "object",
        "required": ["asset_id", "name", "duration_ms"],
        "properties": {
          "asset_id": { "type": "string" },
          "duration_ms": { "type": "integer", "format": "int64" },
          "name": { "type": "string" }
        }
      },
      "AudioLayer": {
        "type": "object",
        "required": ["id", "enabled", "start_ms", "end_ms", "source_start_ms", "gain"],
        "properties": {
